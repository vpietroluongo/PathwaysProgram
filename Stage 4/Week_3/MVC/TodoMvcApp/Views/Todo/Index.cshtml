@model IEnumerable<TodoMvcApp.Models.TodoItem>

@{
    ViewData["Title"] = "Todo List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Todo List</h1>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.DueDate)</th>
            <th>@Html.DisplayNameFor(model => model.IsDone)</th>
            <th style="width: 220px;">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <strong>@item.Title</strong>
                @if (!string.IsNullOrWhiteSpace(item.Description))
                {
                    <div class="text-muted small">@item.Description</div>
                }
            </td>
            <td>@(item.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
            <td>
                @if (item.IsDone)
                {
                    <span class="badge bg-success">Done</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Pending</span>
                }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
