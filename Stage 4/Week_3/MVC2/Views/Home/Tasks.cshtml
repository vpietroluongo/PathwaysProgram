@model IEnumerable<mvc.Models.TodoItem>

@{
    ViewData["Title"] = "Tasks";
}

<h1 class="mb-3">My Todo Tasks</h1>

@if (!Model.Any())
{
    <p>No tasks found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Task</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model)
            {
                <tr>
                    <td>@task.Id</td>
                    <td>@task.Title</td>
                    <td>@(task.IsCompleted ? "Completed" : "Pending")</td>
                </tr>
            }
        </tbody>
    </table>
}
